{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 4,
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["custom/weather_sf", "custom/weather_valpo", "pulseaudio", "network", "bluetooth", "tray"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰈹",
            "2": "󰅩",
            "3": "󰓇",
            "4": "󰞷",
            "5": "󰢔",
            "default": ""
        }
    },
    "clock": {
        "format": "󰥔 {:%H:%M - %A %d}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "custom/weather_sf": {
        "exec": "curl -s 'wttr.in/SanFelipe?format=1'",
        "interval": 1800,
        "format": "󰅟 SF: {}"
    },
    "custom/weather_valpo": {
        "exec": "curl -s 'wttr.in/Valparaiso?format=1'",
        "interval": 1800,
        "format": "󰅟 VLP: {}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "max-volume": 150
    },
    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-disconnected": "󰤭 ",
        "on-click-right": "nm-connection-editor"
    },
    "bluetooth": {
        "format": "󰂯 {status}",
        "on-click": "blueman-manager"
    }
}
